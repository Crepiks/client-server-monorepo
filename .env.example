# PostgreSQL credentials for local development only. Choose a local password.
POSTGRES_USER=app
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=app
# Host/port used by locally running Node. Compose overrides the host internally.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# API and Vite ports exposed on localhost.
API_PORT=3000
WEB_PORT=5173
# Server-side Vite proxy target; Compose overrides this with the API service name.
API_PROXY_TARGET=http://localhost:3000
